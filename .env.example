# Copy this file to .env and point it at your API. Never commit real .env files
# or hard-code production URLs — this must always come from the environment.
#
# iOS simulator:        http://localhost:8000
# Android emulator:     http://10.0.2.2:8000
# Physical device
# (Expo Go, same Wi-Fi): http://<your-machine-LAN-IP>:8000
#
# The local Django backend runs via `docker compose up` in the backend repo
# (services: api, celery-worker, celery-beat, postgres, redis, minio) and
# exposes the API on :8000. Do not point this at the Railway production URL
# during development — production lags local by whole features.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
